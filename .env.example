# API key Google (đã bật Google Drive API). Xem README để tạo.
VITE_GOOGLE_API_KEY=

# ID thư mục gốc trên Google Drive (phần cuối URL: drive.google.com/drive/folders/<ID>)
# Thư mục phải được chia sẻ "Bất kỳ ai có đường liên kết" - quyền Người xem.
VITE_DRIVE_ROOT_FOLDER_ID=

# Tiêu đề phụ hiển thị ở trang chủ (tuỳ chọn)
VITE_SITE_SUBTITLE=Lưu giữ những khoảnh khắc hạnh phúc

# Ngày cưới hiển thị trên trang chủ (tuỳ chọn), ví dụ: 25 . 10 . 2026
VITE_WEDDING_DATE=
